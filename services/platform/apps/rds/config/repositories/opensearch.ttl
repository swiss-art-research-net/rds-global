@prefix repo: <http://www.openrdf.org/config/repository#> .
@prefix sr: <http://www.openrdf.org/config/repository/sail#> .
@prefix sail: <http://www.openrdf.org/config/sail#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ephedra: <http://www.researchspace.org/resource/system/ephedra#> .
@prefix : <http://www.researchspace.org/resource/system/service/custom#> .

[] a repo:Repository ;
  repo:repositoryID "opensearch" ;
  rdfs:label "Repository to connect to OpenSearch node" ;
  repo:repositoryImpl [
    repo:repositoryType "openrdf:SailRepository" ;
    sr:sailImpl [
      sail:sailType "researchspace:RESTSail" ;
      ephedra:serviceURL "http://opensearch-connector:8000/search" ;
      ephedra:httpMethod "POST" ;
      ephedra:implementsService :OpenSearchService
    ]
  ] .
