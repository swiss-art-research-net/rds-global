
PREFIX sp: <http://spinrdf.org/sp#>
PREFIX spin: <http://spinrdf.org/spin#>
PREFIX spl: <http://spinrdf.org/spl#>
PREFIX ephedra: <http://www.researchspace.org/resource/system/ephedra#>
PREFIX sail: <http://www.openrdf.org/config/sail#>
PREFIX os: <http://www.researchspace.com/resource/assets/Ontologies/opensearch#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX : <http://www.researchspace.org/resource/system/service/custom#>

:OpenSearchService a ephedra:Service ;
	sail:sailType "researchspace:RESTSail" ;
	rdfs:label "A wrapper for the LibraryCloud service.";
	ephedra:hasSPARQLPattern (

    [
      sp:subject :_hits ;
      sp:predicate os:searchTerm ;
      sp:object :_query
    ]

    [
      sp:subject :_hits ;
      sp:predicate os:searchDataset ;
      sp:object :_dataset
    ]

    [
      sp:subject :_hits ;
      sp:predicate os:searchTypeClass ;
      sp:object :_typeclass
    ]

    [
      sp:subject :_hits ;
      sp:predicate os:searchLimit ;
      sp:object :_limit
    ]

    [
      sp:subject :_hits ;
      sp:predicate os:hasDescription ;
      sp:object :_description
    ]
        
    [
      sp:subject :_hits ;
      sp:predicate os:hasDataset ;
      sp:object :_datasets
    ]

    [
      sp:subject :_hits ;
      sp:predicate os:hasMatches ;
      sp:object :_matches
    ]
        
    [
      sp:subject :_hits ;
      sp:predicate os:hasTypeClass ;
      sp:object :_typeclasses
    ]
        
    [
      sp:subject :_hits ;
      sp:predicate os:hasTypes ;
      sp:object :_types
    ]

    [
      sp:subject :_hits ;
      sp:predicate os:hasPrefLabel ;
      sp:object :_prefLabel
    ]

    [
      sp:subject :_hits ;
      sp:predicate os:hasReference ;
      sp:object :_reference
    ]

    [
      sp:subject :_hits ;
      sp:predicate os:hasScore ;
      sp:object :_score
    ]
    
    [
      sp:subject :_hits ;
      sp:predicate os:hasSubject ;
      sp:object :_subject
    ]
  );

  spin:constraint [
    a spl:Argument ;
    rdfs:comment "search term" ;
    spl:predicate :_query ;
    spl:valueType xsd:string ;
  ] ;

  spin:constraint [
    a spl:Argument ;
    rdfs:comment "dataset" ;
    spl:predicate :_dataset ;
    spl:valueType xsd:string ;
  ] ;

  spin:constraint [
    a spl:Argument ;
    rdfs:comment "type class" ;
    spl:predicate :_typeclass ;
    spl:valueType xsd:string ;
  ] ;

  spin:constraint [
    a spl:Argument ;
    rdfs:comment "result limit" ;
    spl:predicate :_limit ;
    spl:valueType xsd:integer ;
  ] ;

  spin:column [
    a spin:Column ;
    rdfs:comment "The search hits" ;
    spl:predicate :_hits ;
    spl:valueType rdfs:Resource;
    ephedra:jsonPath "$.hits.hits[*]"
  ] ;

  spin:column [
    a spin:Column ;
    rdfs:comment "The dataset" ;
    spl:predicate :_datasets ;
    spl:valueType xsd:string;
    ephedra:jsonPath "$._source.dataset"
  ] ;

  spin:column [
    a spin:Column ;
    rdfs:comment "The preferred label" ;
    spl:predicate :_prefLabel ;
    spl:valueType xsd:string;
    ephedra:jsonPath "$._source.prefLabels[0]"
  ]  ;

  spin:column [
    a spin:Column ;
    rdfs:comment "The type class" ;
    spl:predicate :_typeclasses ;
    spl:valueType xsd:string;
    ephedra:jsonPath "$._source.typeClasses[0]"
  ]  ;

  spin:column [
    a spin:Column ;
    rdfs:comment "The types" ;
    spl:predicate :_types ;
    spl:valueType xsd:string;
    ephedra:jsonPath "$._source.types[*]"
  ]  ;

  spin:column [
    a spin:Column ;
    rdfs:comment "The reference" ;
    spl:predicate :_reference ;
    spl:valueType rdfs:Resource;
    ephedra:jsonPath "$._reference"
  ] ;

  spin:column [
    a spin:Column ;
    rdfs:comment "The description" ;
    spl:predicate :_description ;
    spl:valueType xsd:string;
    ephedra:jsonPath "$._source.description"
  ]  ;

  spin:column [
    a spin:Column ;
    rdfs:comment "The matches" ;
    spl:predicate :_matches ;
    spl:valueType xsd:string;
    ephedra:jsonPath "$._source.matches[*]"
  ] ;
  
  spin:column [
    a spin:Column ;
    rdfs:comment "The relevance score" ;
    spl:predicate :_score ;
    spl:valueType xsd:float;
    ephedra:jsonPath "$._score"
  ] ;

  spin:column [
    a spin:Column ;
    rdfs:comment "The subject URI" ;
    spl:predicate :_subject ;
    spl:valueType rdfs:Resource;
    ephedra:jsonPath "$._source.uri"
  ]
  .
      
